<?xml version="1.0" encoding="utf-8"?>
<!--
  The home LAN's servers (*.haloworld.lan) have certificates from a private CA ("LAN Intermediate CA"). Android trusts
  only system CAs by default; for these hosts the app also trusts CAs the user installed (Settings > Security >
  Encryption & credentials > Install a certificate > CA certificate), so install the LAN root CA on the device.
  Everything else keeps the default (system CAs only). Metro (localhost, debug builds) needs cleartext.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">haloworld.lan</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
