From 72376782d230d4abe4a3117f11cfe5b26c283481 Mon Sep 17 00:00:00 2001
From: krab3000 <336138103+krab3000@users.noreply.github.com>
Date: Fri, 16 Oct 2026 09:30:36 +0300
Subject: [PATCH 3/6] Packaging scripts: ndk_triple empty before path.sh (set
 -u)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 buildscripts/bundle_default.sh | 1 +
 buildscripts/verify.sh         | 1 +
 buildscripts/write-manifest.sh | 1 +
 3 files changed, 3 insertions(+)

diff --git a/buildscripts/bundle_default.sh b/buildscripts/bundle_default.sh
index 6fc7fb4..91d1e15 100755
--- a/buildscripts/bundle_default.sh
+++ b/buildscripts/bundle_default.sh
@@ -19,6 +19,7 @@ cp flavors/default.sh scripts/ffmpeg.sh
 ./build.sh
 
 . ./include/depinfo.sh
+ndk_triple= # path.sh reads it (set only per ABI in build.sh)
 . ./include/path.sh
 
 # Debug symbols, before stripping
diff --git a/buildscripts/verify.sh b/buildscripts/verify.sh
index 1e256f9..943d317 100644
--- a/buildscripts/verify.sh
+++ b/buildscripts/verify.sh
@@ -5,6 +5,7 @@ set -euo pipefail
 cd "$( dirname "${BASH_SOURCE[0]}" )"
 out=$1
 . ./include/depinfo.sh
+ndk_triple= # path.sh reads it (set only per ABI in build.sh)
 . ./include/path.sh
 
 fail=0
diff --git a/buildscripts/write-manifest.sh b/buildscripts/write-manifest.sh
index 6ae06fd..3afea3d 100644
--- a/buildscripts/write-manifest.sh
+++ b/buildscripts/write-manifest.sh
@@ -4,6 +4,7 @@ set -euo pipefail
 cd "$( dirname "${BASH_SOURCE[0]}" )"
 out=$1
 . ./include/depinfo.sh
+ndk_triple= # path.sh reads it (set only per ABI in build.sh)
 . ./include/path.sh
 
 describe () { git -C deps/$1 describe --tags --always 2>/dev/null || echo "-"; }
-- 
