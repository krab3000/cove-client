+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	exit 0
+else
+	exit 255
+fi
+
+unset CC CXX # meson wants these unset
+
+# Cove: new; mpv requires libplacebo (>= 7.360.1). OpenGL ES only (mpv's vo=gpu on Android), no Vulkan or shader
+# compilers. It has C++ in it: libc++ is linked in statically (the jar ships no libc++_shared.so), so its .pc names
+# the NDK's static libc++ (the NDK's -lc++ is a script that points at libc++_shared).
+meson setup $build --cross-file "$prefix_dir"/crossfile.txt \
+	-Dopengl=enabled \
+	-D{vulkan,glslang,shaderc,lcms,d3d11,dovi,libdovi,unwind,xxhash}=disabled \
+	-D{demos,tests,bench,fuzz}=false
+
+ninja -C $build -j$cores
+DESTDIR="$prefix_dir" ninja -C $build install
+
+extra="-lc++_static -lc++abi"
+[[ "$ndk_triple" == "arm-"* ]] && extra="$extra -l:libunwind.a"
+${SED:-sed} -i "/^Libs:/ s|\$| $extra|" "$prefix_dir/lib/pkgconfig/libplacebo.pc"
