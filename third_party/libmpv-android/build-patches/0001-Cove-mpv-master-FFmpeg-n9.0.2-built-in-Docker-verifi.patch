+# Cove: every source pinned. A clone is checked against its commit, a tarball against its sha256. GitHub mirrors
+# where they exist (gitlab.freedesktop.org timed out from here).
+
+# clone_pinned <dir> <url> <tag> <sha> [git clone options]: a shallow clone of the tag, which must be that commit
+clone_pinned () {
+	local dir=$1 url=$2 ref=$3 sha=$4
+	shift 4
+	if [ ! -d "$dir" ]; then
+		git clone --depth 1 --branch "$ref" "$@" "$url" "$dir"
+	fi
+	local head=$(git -C "$dir" rev-parse HEAD)
+	if [ "$head" != "$sha" ]; then
+		echo >&2 "$dir: $ref is $head, expected $sha"
+		exit 1
+	fi
+}
+
+# tarball_pinned <dir> <url> <sha256>: downloaded, checked, unpacked into <dir>
+tarball_pinned () {
+	local dir=$1 url=$2 sha256=$3
+	[ -d "$dir" ] && return 0
+	local file=$(basename "$url")
+	$WGET -q -O "$file" "$url"
+	echo "$sha256  $file" | sha256sum -c -
+	mkdir "$dir"
+	tar -xf "$file" -C "$dir" --strip-components=1
+	rm "$file"
+}
