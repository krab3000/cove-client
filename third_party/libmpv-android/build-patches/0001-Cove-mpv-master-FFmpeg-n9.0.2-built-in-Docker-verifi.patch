new file mode 100644
index 0000000..6ae06fd
--- /dev/null
+++ b/buildscripts/write-manifest.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+# Cove: versions.txt in <out>: what these jars were built from and with
+set -euo pipefail
+cd "$( dirname "${BASH_SOURCE[0]}" )"
+out=$1
+. ./include/depinfo.sh
+. ./include/path.sh
+
+describe () { git -C deps/$1 describe --tags --always 2>/dev/null || echo "-"; }
+sha () { git -C deps/$1 rev-parse HEAD 2>/dev/null || echo "-"; }
+
+{
+	echo "# libmpv for media_kit (Android): mpv master + FFmpeg 9, LGPL, built by Cove"
+	echo "built            $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+	echo "build repo       media-kit/libmpv-android-video-build, branch cove/mpv-master-ffmpeg9 @ ${BUILD_REPO_COMMIT:-unknown}"
+	echo "docker image     ${IMAGE_ID:-unknown}"
+	echo "ndk              $v_ndk ($(grep Pkg.Revision "$ndk_root/source.properties" | cut -d= -f2 | tr -d ' ')), api level $v_apilvl"
+	echo "meson            $(meson --version), ninja $(ninja --version)"
+	echo
+	for d in mpv ffmpeg libplacebo dav1d libass freetype libxml2 media-kit-android-helper; do
+		printf '%-26s %-34s %s\n' "$d" "$(describe $d)" "$(sha $d)"
+	done
+	printf '%-26s %-34s sha256 %s\n' mbedtls "$v_mbedtls" "$v_mbedtls_sha256"
+	printf '%-26s %-34s sha256 %s\n' fribidi "$v_fribidi" "$v_fribidi_sha256"
+	printf '%-26s %-34s sha256 %s\n' harfbuzz "$v_harfbuzz" "$v_harfbuzz_sha256"
+	echo
+	echo "patches"
+	for p in patches/*/*; do echo "  $p $(sha1sum "$p" | cut -d' ' -f1)"; done
+	echo
+	echo "libmpv.so (stripped) bytes"
+	for abi in arm64-v8a armeabi-v7a x86_64 x86; do
+		printf '  %-12s %s\n' $abi "$(stat -c%s staging/lib/$abi/libmpv.so)"
+	done
+	echo
+	echo "md5"; sed 's/^/  /' "$out/md5sums.txt"
+	echo "sha256"; sed 's/^/  /' "$out/sha256sums.txt"
+} >"$out/versions.txt"
+cat "$out/versions.txt"
diff --git a/docker/Dockerfile b/docker/Dockerfile
new file mode 100644
index 0000000..181bec4
--- /dev/null
+++ b/docker/Dockerfile
@@ -0,0 +1,27 @@
+# Cove: the build environment for buildscripts/bundle_default.sh (docker/run.sh builds and runs it)
+FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
+
+ENV DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && apt-get install -y --no-install-recommends \
+		build-essential autoconf automake libtool pkg-config nasm ninja-build \
+		python3 python3-venv git wget curl ca-certificates unzip zip xz-utils bzip2 \
+		file rsync patch perl gawk gettext autopoint \
+	&& rm -rf /var/lib/apt/lists/*
+
+RUN python3 -m venv /opt/meson && /opt/meson/bin/pip install --no-cache-dir meson==1.12.1 \
+	&& ln -s /opt/meson/bin/meson /usr/local/bin/meson
+
+# The upstream scripts call sudo in places; as root it only runs the command
+RUN printf '#!/bin/sh\nexec "$@"\n' >/usr/local/bin/sudo && chmod +x /usr/local/bin/sudo
+
+# The NDK, checked against Google's repository manifest (buildscripts/include/depinfo.sh: v_ndk, v_ndk_sha1)
+ARG NDK=r30
+ARG NDK_SHA1=5107f898313790e449e87eee2183d9a20602dee9
+RUN wget -q https://dl.google.com/android/repository/android-ndk-$NDK-linux.zip \
+	&& echo "$NDK_SHA1  android-ndk-$NDK-linux.zip" | sha1sum -c - \
+	&& unzip -q android-ndk-$NDK-linux.zip -d /opt \
+	&& rm android-ndk-$NDK-linux.zip
+ENV ANDROID_NDK_HOME=/opt/android-ndk-r30
+
+RUN git config --global advice.detachedHead false && git config --global core.autocrlf false
+WORKDIR /work
diff --git a/docker/entry.sh b/docker/entry.sh
new file mode 100644
index 0000000..552e83e
--- /dev/null
+++ b/docker/entry.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Cove: in the container. The scripts come in read-only (/src), are copied next to the sources and builds, which
+# stay in Docker's volume (/work) between runs; the jars go out to /out.
+set -euo pipefail
+mkdir -p /work/buildscripts
+rsync -a --delete \
+	--exclude=deps --exclude=prefix --exclude=sdk --exclude=staging --exclude=artifacts \
+	/src/buildscripts/ /work/buildscripts/
+cd /work/buildscripts
+find . -name '*.sh' -exec chmod +x {} +
+if [ $# -gt 0 ]; then
+	exec "$@"
+fi
+./bundle_default.sh
+rm -rf /out/default && mkdir -p /out/default
+cp -r artifacts/default/. /out/default/
+echo "jars: artifacts/default"
diff --git a/docker/run.sh b/docker/run.sh
new file mode 100644
index 0000000..5175fef
--- /dev/null
+++ b/docker/run.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Cove: builds the jars in Docker, from Git Bash on Windows (or any bash with Docker).
+#   docker/run.sh                     build everything (dependencies that are built and unchanged are skipped)
+#   CLEAN=1 docker/run.sh             from fresh sources
+#   docker/run.sh ./build.sh -n mpv   one step, in the container (here: mpv again, without its dependencies)
+# Sources, objects and prefixes live in the Docker volume libmpv-android-work (bind mounts are slow on Windows);
+# `docker volume rm libmpv-android-work` forgets them. The jars, sums and versions.txt: artifacts/default/.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+image=cove/libmpv-android:ndk-r30
+docker build -t $image docker
+docker volume create libmpv-android-work >/dev/null
+mkdir -p artifacts
+
+here=$(pwd -W 2>/dev/null || pwd)
+commit="$(git rev-parse HEAD)$(git diff --quiet HEAD -- buildscripts docker || echo -dirty)"
+MSYS_NO_PATHCONV=1 docker run --rm -t \
+	-e CLEAN="${CLEAN:-0}" -e cores="${cores:-$(nproc 2>/dev/null || echo 8)}" \
+	-e BUILD_REPO_COMMIT="$commit" \
+	-e IMAGE_ID="$(docker image inspect -f '{{.Id}}' $image)" \
+	-v libmpv-android-work:/work \
+	-v "$here/buildscripts:/src/buildscripts:ro" \
+	-v "$here/docker:/src/docker:ro" \
+	-v "$here/artifacts:/out" \
+	$image bash /src/docker/entry.sh "$@"
