diff --git a/buildscripts/verify.sh b/buildscripts/verify.sh
new file mode 100644
index 0000000..1e256f9
--- /dev/null
+++ b/buildscripts/verify.sh
@@ -0,0 +1,55 @@
+#!/bin/bash
+# Cove: checks that the jars in <out> are drop-in replacements for media_kit's (v1.1.7's): the layout, the libraries'
+# names, what they link against, what they export, 16 KB pages, and that this is the mpv and FFmpeg meant.
+set -euo pipefail
+cd "$( dirname "${BASH_SOURCE[0]}" )"
+out=$1
+. ./include/depinfo.sh
+. ./include/path.sh
+
+fail=0
+bad () { echo "FAIL $*"; fail=1; }
+ok () { echo "ok   $*"; }
+
+allowed_needed="libc.so libm.so libdl.so liblog.so libandroid.so libEGL.so libGLESv2.so libGLESv3.so libmediandk.so libOpenSLES.so libaaudio.so libz.so"
+mpv_short=${v_mpv:0:7}
+
+tmp=$(mktemp -d)
+for pair in arm64-v8a:AArch64 armeabi-v7a:ARM x86_64:X86-64 x86:"Intel 80386"; do
+	abi=${pair%%:*} machine=${pair#*:}
+	jar="$out/default-$abi.jar"
+	echo "== $abi"
+	rm -rf "$tmp"/*
+	unzip -q "$jar" -d "$tmp"
+	files=$(cd "$tmp" && find . -type f | sed 's#^\./##' | sort | tr '\n' ' ')
+	[ "$files" == "lib/$abi/libmediakitandroidhelper.so lib/$abi/libmpv.so " ] && ok "contents: $files" || bad "contents: $files"
+	for so in libmpv.so libmediakitandroidhelper.so; do
+		f="$tmp/lib/$abi/$so"
+		llvm-readelf -h "$f" | grep -q "Machine:.*$machine" && ok "$so: $machine" || bad "$so: not $machine"
+		soname=$(llvm-readelf -d "$f" | sed -n 's/.*(SONAME).*\[\(.*\)\]/\1/p')
+		[ "$soname" == "$so" ] && ok "$so: soname" || bad "$so: soname $soname"
+		for n in $(llvm-readelf -d "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'); do
+			[[ " $allowed_needed " == *" $n "* ]] || bad "$so: needs $n"
+		done
+		ok "$so: needs $(llvm-readelf -d "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' | tr '\n' ' ')"
+		small=$(llvm-readelf -lW "$f" | gawk '$1=="LOAD" && strtonum($NF) < 16384' | wc -l)
+		[ "$small" == "0" ] && ok "$so: 16 KB pages" || bad "$so: LOAD segments under 16 KB alignment"
+		if llvm-nm -D --defined-only "$f" | awk '{print $3}' | grep -qE '^(_ZNSt|_ZNKSt|__cxa_)'; then
+			bad "$so: exports the C++ runtime"
+		fi
+	done
+	f="$tmp/lib/$abi/libmpv.so"
+	missing=$(comm -23 verify/mpv_exports_v1.1.7.txt <(llvm-nm -D --defined-only "$f" | awk '{print $3}' | grep '^mpv_' | sort))
+	[ -z "$missing" ] && ok "libmpv.so: exports v1.1.7's mpv_* API" || bad "libmpv.so: missing $(echo $missing)"
+	llvm-nm -D --defined-only "$f" | grep -q ' mpv_lavc_set_java_vm$' && ok "libmpv.so: mpv_lavc_set_java_vm" || bad "libmpv.so: no mpv_lavc_set_java_vm"
+	h="$tmp/lib/$abi/libmediakitandroidhelper.so"
+	missing=$(comm -23 verify/helper_exports_v1.1.7.txt <(llvm-nm -D --defined-only "$h" | awk '{print $3}' | sort))
+	[ -z "$missing" ] && ok "helper: exports" || bad "helper: missing $(echo $missing)"
+	strings=$(llvm-strings "$f")
+	version=$(grep -oE "mpv v0\.[0-9]+\.[0-9]+[-a-z0-9.]*" <<<"$strings" | head -1)
+	[[ "$version" == *"g$mpv_short"* ]] && ok "mpv: $version" || bad "mpv: $version (wanted $mpv_short)"
+	grep -q "FFmpeg version $v_ffmpeg" <<<"$strings" && ok "FFmpeg $v_ffmpeg" || bad "no FFmpeg $v_ffmpeg"
+	grep -q "AImageReader_newWithUsage" <<<"$strings" && ok "aimagereader" || bad "no aimagereader"
+done
+rm -rf "$tmp"
+[ $fail -eq 0 ] && echo "verify: all good" || { echo "verify: FAILED"; exit 1; }
