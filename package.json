{
  "name": "react-native-mpv-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "android": "yarn workspace mpv-test android",
    "start:test": "yarn workspace mpv-test start",
    "setup:android:local": "build-tools setup android",
    "setup:windows:local": "build-tools setup windows",
    "build:android:local": "turbo run build:android:local --filter=react-native-mpv-cove-client",
    "build:android:docker": "turbo run build:android:docker --filter=react-native-mpv-cove-client",
    "build:windows:local": "turbo run build:windows:local --filter=react-native-mpv-cove-client",
    "test-cache": "yarn workspace react-native-mpv test-cache",
    "make-test-media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-test-media.ps1",
    "typecheck": "yarn workspace react-native-mpv typecheck && yarn workspace rn-trace typecheck && yarn workspace react-native-mpv-cove-client typecheck && yarn workspace mpv-test typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "cove:windows": "yarn workspace react-native-mpv-cove-client windows",
    "start:cove": "yarn workspace react-native-mpv-cove-client start",
    "cove:android": "yarn workspace react-native-mpv-cove-client android",
    "cove:server": "yarn workspace react-native-mpv-cove-client test-server"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "0.86.2",
    "build-tools": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "turbo": "2.11.8",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
