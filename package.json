{
  "name": "react-native-libav-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "windows": "yarn workspace react-native-libav-example-windows windows",
    "android": "yarn workspace react-native-libav-example-android android",
    "start:windows": "yarn workspace react-native-libav-example-windows start",
    "start:android": "yarn workspace react-native-libav-example-android start",
    "fetch-ffmpeg": "yarn workspace react-native-libav fetch-ffmpeg",
    "build-ffmpeg-android": "yarn workspace react-native-libav build-ffmpeg-android",
    "setup-android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android-toolchain.ps1",
    "make-test-media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-test-media.ps1",
    "typecheck": "yarn workspace react-native-libav typecheck && yarn workspace react-native-libav-example-ui typecheck && yarn workspace react-native-libav-cove-client typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "cove:windows": "yarn workspace react-native-libav-cove-client windows",
    "start:cove": "yarn workspace react-native-libav-cove-client start",
    "cove:android": "yarn workspace react-native-libav-cove-client android"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "0.86.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
