<?xml version="1.0" encoding="utf-8"?>
<!-- FFmpeg SDK (headers, MSVC import libs, DLLs) laid out by scripts/fetch-ffmpeg.ps1. Override with /p:FFmpegDir=... -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- The platform-neutral engine (cpp/), compiled into this project. -->
    <SharedEngineDir>$(MSBuildThisFileDirectory)..\..\cpp\</SharedEngineDir>
    <FFmpegDir Condition="'$(FFmpegDir)' == ''">$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\win-x64\</FFmpegDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FFmpegDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FFmpegDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>avformat.lib;avcodec.lib;avutil.lib;swresample.lib;swscale.lib;d3d11.lib;d3dcompiler.lib;dxgi.lib;dwmapi.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Shipped next to the app: DeploymentContent puts them in the MSIX (from $(OutDir), see CopyFFmpegDlls). -->
    <None Include="$(FFmpegDir)bin\*.dll">
      <DeploymentContent>true</DeploymentContent>
    </None>
  </ItemGroup>
  <Target Name="CheckFFmpegSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(FFmpegDir)include\libavcodec\avcodec.h')" Text="FFmpeg SDK not found in $(FFmpegDir). Run: yarn fetch-ffmpeg" />
  </Target>
  <Target Name="CopyFFmpegDlls" AfterTargets="Build">
    <Copy SourceFiles="@(None)" Condition="'%(Extension)' == '.dll'" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- Where the consuming app's packaging project looks for this project's deployment content. -->
    <Copy SourceFiles="@(None)" Condition="'%(Extension)' == '.dll'" DestinationFolder="$(OutDir)$(ProjectName)" SkipUnchangedFiles="true" />
  </Target>
</Project>
