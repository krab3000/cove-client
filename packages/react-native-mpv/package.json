{
  "name": "react-native-mpv",
  "version": "0.1.0",
  "description": "mpv (libmpv) video player view for React Native on Android and Windows: hardware decoding (MediaCodec, D3D11VA), software decoding for everything else, http(s) streamed through a RAM/disk cache",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-mpv-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cpp",
    "windows",
    "!windows/**/x64",
    "!windows/**/ARM64",
    "!windows/**/Debug",
    "!windows/**/Release",
    "!windows/packages",
    "android",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "scripts",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc -p .",
    "clean": "del-cli lib android/build android/.cxx windows/x64 windows/ReactNativeMpv/x64",
    "build-mpv-android": "bash scripts/mpv-android/build-docker.sh",
    "build-mpv-windows": "bash scripts/mpv-windows/build-docker.sh",
    "test-cache": "bash scripts/test-cache.sh",
    "codegen-windows": "react-native-windows-codegen --files \"src/*NativeComponent.ts\" --libraryName MpvSpec --namespace ReactNativeMpvCodegen --outputDirectory windows/ReactNativeMpv/codegen --componentsWindows --separateDataTypes"
  },
  "keywords": [
    "react-native",
    "android",
    "mpv",
    "libmpv",
    "ffmpeg",
    "video",
    "mediacodec",
    "windows",
    "d3d11va"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krab3000/react-native-mpv.git"
  },
  "author": "krab3000 <echekanskiy@gmail.com> (https://github.com/krab3000)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/krab3000/react-native-mpv/issues"
  },
  "homepage": "https://github.com/krab3000/react-native-mpv#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native-windows/codegen": "0.84.0",
    "@react-native/babel-preset": "0.84.1",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "MpvSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "windows": {
      "namespace": "ReactNativeMpvCodegen",
      "generators": [
        "componentsWindows"
      ],
      "outputDirectory": "windows/ReactNativeMpv/codegen",
      "separateDataTypes": true
    },
    "android": {
      "javaPackageName": "com.rnmpv"
    }
  },
  "react-native-windows": {
    "init-windows": {
      "name": "ReactNativeMpv",
      "namespace": "ReactNativeMpv",
      "template": "cpp-lib"
    }
  }
}
