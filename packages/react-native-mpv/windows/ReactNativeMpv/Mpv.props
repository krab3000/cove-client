<?xml version="1.0" encoding="utf-8"?>
<!-- libmpv and its FFmpeg (headers, DLLs) built by scripts/mpv-windows into third_party/mpv. Override with /p:MpvDir=... -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- The platform-neutral engine (cpp/: MpvPlayer and the HTTP cache), compiled into this project. -->
    <SharedEngineDir>$(MSBuildThisFileDirectory)..\..\cpp\</SharedEngineDir>
    <MpvDir Condition="'$(MpvDir)' == ''">$(MSBuildThisFileDirectory)..\..\third_party\mpv\win-x64\</MpvDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SharedEngineDir);$(MpvDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- libmpv itself is loaded at run time (LoadLibrary): no import library. -->
      <AdditionalDependencies>d3d11.lib;dxgi.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Shipped next to the app: DeploymentContent puts them in the MSIX (from $(OutDir), see CopyMpvDlls). -->
    <None Include="$(MpvDir)bin\*.dll">
      <DeploymentContent>true</DeploymentContent>
    </None>
  </ItemGroup>
  <Target Name="CheckMpvSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="react-native-mpv: Windows builds are x64 only for now (third_party/mpv/win-x64)." />
    <Error Condition="!Exists('$(MpvDir)include\mpv\d3d11_composition.h') Or !Exists('$(MpvDir)bin\libmpv-2.dll')" Text="libmpv for Windows not found in $(MpvDir). Run: yarn build-mpv-windows" />
  </Target>
  <Target Name="CopyMpvDlls" AfterTargets="Build">
    <Copy SourceFiles="@(None)" Condition="'%(Extension)' == '.dll'" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- Where the consuming app's packaging project looks for this project's deployment content. -->
    <Copy SourceFiles="@(None)" Condition="'%(Extension)' == '.dll'" DestinationFolder="$(OutDir)$(ProjectName)" SkipUnchangedFiles="true" />
  </Target>
</Project>
