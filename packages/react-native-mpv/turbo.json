{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:android:docker": {
      "inputs": [
        "scripts/android.Dockerfile",
        "scripts/android.Dockerfile.dockerignore",
        "scripts/ffmpeg-android/**",
        "scripts/mpv-android/**"
      ],
      "outputs": ["third_party/ffmpeg/android-arm64-v8a/**", "third_party/mpv/android-arm64-v8a/**"]
    },
    "build:windows:docker": {
      "inputs": ["scripts/mpv-windows/**"],
      "outputs": ["third_party/mpv/win-x64/**"]
    }
  }
}
