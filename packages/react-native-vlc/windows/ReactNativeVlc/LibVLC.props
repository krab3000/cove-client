<?xml version="1.0" encoding="utf-8"?>
<!-- libVLC 4 SDK (headers, MSVC import lib, DLLs + plugins) laid out by scripts/fetch-libvlc.ps1. Override with /p:LibVlcDir=... -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LibVlcDir Condition="'$(LibVlcDir)' == ''">$(MSBuildThisFileDirectory)..\..\third_party\libvlc\win-x64\</LibVlcDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LibVlcDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(LibVlcDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libvlc.lib;d3d11.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Shipped next to the app: libvlc.dll, libvlccore.dll, and the plugins\ and lua\ trees beside them (libVLC
         looks for plugins\ next to libvlc.dll). DeploymentContent puts them in the MSIX; see CopyLibVlc.
         TODO: the packaging project also adds a second copy (~200 MB) under ReactNativeVlc\. -->
    <None Include="$(LibVlcDir)bin\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <Target Name="CheckLibVlcSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LibVlcDir)include\vlc\vlc.h')" Text="libVLC SDK not found in $(LibVlcDir). Run: yarn workspace react-native-vlc fetch-libvlc" />
  </Target>
  <Target Name="CopyLibVlc" AfterTargets="Build">
    <Copy SourceFiles="@(None)" Condition="'%(None.Link)' != ''" DestinationFiles="@(None->'$(OutDir)%(Link)')" SkipUnchangedFiles="true" />
    <!-- Where the consuming app's packaging project looks for this project's deployment content. -->
    <Copy SourceFiles="@(None)" Condition="'%(None.Link)' != ''" DestinationFiles="@(None->'$(OutDir)$(ProjectName)\%(Link)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
