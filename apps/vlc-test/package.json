{
  "name": "react-native-vlc-test",
  "version": "0.0.1",
  "private": true,
  "description": "A test player for react-native-vlc on Windows: open a local file or URL, pick audio and subtitle tracks",
  "scripts": {
    "windows": "npx @react-native-community/cli run-windows",
    "start": "react-native start",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-vlc": "workspace:*",
    "react-native-windows": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "VlcTest",
      "namespace": "VlcTest",
      "template": "cpp-app"
    }
  }
}
